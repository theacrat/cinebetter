TMDB_TOKEN="" # Note that this must be the read access token, not the standard API key - required for the hide low quality results option

USE_CACHE="true" # Recommended true for prod, false only for debugging

IMDB_PROXY_URL="" # Optional https:// URL of proxy/imdb-proxy.ts, used only when a direct IMDb request fails
IMDB_PROXY_TOKEN="" # Sent to the proxy as the X-Proxy-Token header

## Bun only (not used in Cloudflare Workers)
PORT="3000"

SQLITE_DB="file:dev.db" # Used for storing IMDb/TMDB mappings
SQLITE_AUTH="" # If your DB requires a token

VALKEY_HOST="localhost" # If you have a Valkey instance
VALKEY_PORT="6379" # If you have a non-default Valkey port
VALKEY_USERNAME="" # Not required if using the Dockercompose
VALKEY_PASSWORD="" # If your Valkey instance is password protected, or you want the Docker instance to be
VALKEY_TLS="false" # If your Valkey instance requires TLS

CACHE_DAYS_CATALOG="1" # How many days Valkey should store cached catalog requests
CACHE_DAYS_META="7" # How many days Valkey should store cached meta requests
